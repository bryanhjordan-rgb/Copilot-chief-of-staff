{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Looks done — mark complete?",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "{{ITEM_TITLE}}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "{{EVIDENCE}}",
      "isSubtle": true,
      "wrap": true
    },
    {
      "type": "Input.Text",
      "id": "minutesSpent",
      "placeholder": "Minutes spent (optional)",
      "style": "Text"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Mark complete",
      "style": "positive",
      "data": {
        "action": "complete",
        "itemId": "{{ITEM_ID}}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Not yet",
      "data": {
        "action": "not_yet",
        "itemId": "{{ITEM_ID}}"
      }
    }
  ]
}
